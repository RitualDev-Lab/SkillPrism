  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RitualDev-Lab/SkillPrism.git"
  },
  "homepage": "https://ritualdev.in/skillprism/",
  "bugs": {
    "url": "https://github.com/RitualDev-Lab/SkillPrism/issues",
    "email": "support@ritualdev.in"
  },
  "keywords": [
    "ai-agent-security",
    "mcp-server",
    "sandbox",
    "developer-tools",
    "cursor-ide",
    "windsurf-ai",
    "llm-security",
    "skillprism",
    "context-window",
    "token-optimization",
    "progressive-disclosure",
    "context-compaction",
    "semantic-receipts"
